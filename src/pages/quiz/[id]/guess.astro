---
// src/pages/quiz/[id]/guess.astro
import Layout from '../../../layouts/Layout.astro';
import QuizStages from '../../../components/QuizStages.astro';
import { displayText } from '../../../lib/display-text';
import { getSpotifyTrackId } from '../../../lib/quiz-display';
import { db } from '../../../lib/db';
import {
  quizzes,
  songSubmissions,
  guesses,
  quizParticipants,
  quizAdmins,
  user as userTable,
} from '../../../lib/db/schema';
import { eq, and, sql } from 'drizzle-orm';

const { user } = Astro.locals;
const { id } = Astro.params;

// Redirect if not logged in
if (!user) {
  return Astro.redirect(`/login?redirect=/quiz/${id}/guess`);
}

// Get quiz details
const [quiz] = await db
  .select()
  .from(quizzes)
  .where(eq(quizzes.id, parseInt(id!)))
  .limit(1);

if (!quiz) {
  return Astro.redirect('/');
}

// Only allow guessing stage
if (quiz.status !== 'guessing') {
  return Astro.redirect(`/quiz/${id}`);
}

// Check if user is admin
const [isAdmin] = await db
  .select()
  .from(quizAdmins)
  .where(and(eq(quizAdmins.quizId, quiz.id), eq(quizAdmins.userId, user.id)))
  .limit(1);

// Check if user is a participant
const [isParticipant] = await db
  .select()
  .from(quizParticipants)
  .where(
    and(
      eq(quizParticipants.quizId, quiz.id),
      eq(quizParticipants.userId, user.id),
    ),
  )
  .limit(1);

// Get all submissions (without revealing who submitted)
const submissions = await db
  .select({
    id: songSubmissions.id,
    songLink: songSubmissions.songLink,
    songTitle: songSubmissions.songTitle,
    artist: songSubmissions.artist,
    userId: songSubmissions.userId, // We'll need this to check correctness but won't show it
  })
  .from(songSubmissions)
  .where(eq(songSubmissions.quizId, quiz.id));

// Get all participants that have submitted a song for the dropdown
const participants = await db
  .selectDistinct({
    id: userTable.id,
    name: userTable.name,
  })
  .from(quizParticipants)
  .innerJoin(userTable, eq(quizParticipants.userId, userTable.id))
  .innerJoin(
    songSubmissions,
    and(
      eq(songSubmissions.userId, quizParticipants.userId),
      eq(songSubmissions.quizId, quiz.id),
    ),
  )
  .where(eq(quizParticipants.quizId, quiz.id));

// Get user's existing guesses
const userGuesses = await db
  .select({
    songSubmissionId: guesses.songSubmissionId,
    guessedUserId: guesses.guessedUserId,
  })
  .from(guesses)
  .where(and(eq(guesses.quizId, quiz.id), eq(guesses.guesserId, user.id)));

// Create a map of existing guesses
const guessMap = new Map(
  userGuesses.map((g) => [g.songSubmissionId, g.guessedUserId]),
);

let error = '';
let success =
  Astro.url.searchParams.get('saved') === '1'
    ? 'Dina gissningar har sparats!'
    : '';

// Handle POST requests
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action')?.toString();

    if (action === 'join') {
      if (!isParticipant) {
        await db.insert(quizParticipants).values({
          quizId: quiz.id,
          userId: user.id,
        });
      }
      return Astro.redirect(`/quiz/${id}/guess`);
    } else if (action === 'submit_guesses') {
      if (!isParticipant) {
        error = 'Du måste gå med i quizet först';
      } else {
        // Get all guesses from form
        const newGuesses: {
          songSubmissionId: number;
          guessedUserId: string;
        }[] = [];

        for (const submission of submissions) {
          const guessedUserId = formData
            .get(`guess_${submission.id}`)
            ?.toString();
          if (guessedUserId) {
            newGuesses.push({
              songSubmissionId: submission.id,
              guessedUserId,
            });
          }
        }

        if (newGuesses.length === 0) {
          error = 'Du måste gissa på minst en låt';
        } else {
          // Delete existing guesses and insert new ones in a transaction
          await db.transaction(async (tx) => {
            // Delete existing guesses for this user in this quiz
            await tx
              .delete(guesses)
              .where(
                and(
                  eq(guesses.quizId, quiz.id),
                  eq(guesses.guesserId, user.id),
                ),
              );

            // Insert new guesses with correctness check
            for (const guess of newGuesses) {
              const submission = submissions.find(
                (s) => s.id === guess.songSubmissionId,
              );
              const isCorrect = submission?.userId === guess.guessedUserId;

              await tx.insert(guesses).values({
                quizId: quiz.id,
                guesserId: user.id,
                songSubmissionId: guess.songSubmissionId,
                guessedUserId: guess.guessedUserId,
                isCorrect: isCorrect,
              });
            }
          });

          success = `Dina gissningar har sparats! (${newGuesses.length} av ${submissions.length} låtar)`;
          return Astro.redirect(`/quiz/${id}/guess?saved=1`);
        }
      }
    } else if (action === 'reset_to_open' && isAdmin) {
      // Admin action: Delete all guesses and change status back to open
      await db.transaction(async (tx) => {
        // Delete all guesses for this quiz
        await tx.delete(guesses).where(eq(guesses.quizId, quiz.id));

        // Change status back to open
        await tx
          .update(quizzes)
          .set({
            status: 'open',
            closedAt: null,
          })
          .where(eq(quizzes.id, quiz.id));
      });

      return Astro.redirect(`/quiz/${id}`);
    }
  } catch (e: any) {
    console.error('Error:', e);
    error = 'Ett fel uppstod. Försök igen.';
  }
}

// Shuffle submissions so they appear in random order (seed with quiz id for consistency)
const shuffledSubmissions = [...submissions].sort((a, b) => {
  // Simple deterministic shuffle based on quiz id and submission ids
  const hashA = (a.id * quiz.id) % 1000;
  const hashB = (b.id * quiz.id) % 1000;
  return hashA - hashB;
});


---

<Layout>
  <div class="container">
    <div class="header">
      <a href={`/quiz/${id}`} class="back-link">← Tillbaka till quizet</a>
      <h1>Vem valde vad?</h1>
      <p class="subtitle">{displayText(quiz.name)}</p>
    </div>

    <QuizStages status="guessing" />

    {error && <div class="error-message" role="alert">{error}</div>}

    {success && (
      <div class="success-message" id="success-message" role="status">
        {success}
      </div>
    )}

    <div class="info-box">
      <p>
        Lyssna på låtarna och gissa vem som skickade in varje låt. Du kan ändra
        dina gissningar när som helst under gissningsfasen.
      </p>
    </div>

    {
      !isParticipant && (
        <div class="join-card">
          <p>
            Du hann inte gå med innan gissningsfasen startade, men du kan
            fortfarande gå med och gissa!
          </p>
          <form method="POST" accept-charset="UTF-8">
            <input type="hidden" name="action" value="join" />
            <button type="submit" class="btn-primary">
              Gå med i quizet
            </button>
          </form>
        </div>
      )
    }

    {
      isParticipant && (
    <form method="POST" accept-charset="UTF-8" class="guessing-form">
      <input type="hidden" name="action" value="submit_guesses" />

      <div class="songs-list">
        {
          shuffledSubmissions.map((submission, index) => {
            const spotifyId = getSpotifyTrackId(submission.songLink);
            const existingGuess = guessMap.get(submission.id);

            return (
              <div class="song-card">
                <div class="song-header">
                  <h3>Låt {index + 1}</h3>
                  {submission.songTitle && (
                    <span class="song-title">{displayText(submission.songTitle)}</span>
                  )}
                </div>

                {submission.artist && <p class="artist">{displayText(submission.artist)}</p>}

                {/* Spotify Embed */}
                {spotifyId ? (
                  <div class="spotify-embed">
                    <iframe
                      title={`Spotify: ${displayText(submission.songTitle) || `Låt ${index + 1}`}`}
                      style="border-radius:12px"
                      src={`https://open.spotify.com/embed/track/${spotifyId}?utm_source=generator`}
                      width="100%"
                      height="152"
                      frameborder="0"
                      allowfullscreen=""
                      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                      loading="lazy"
                    />
                  </div>
                ) : (
                  <a
                    href={submission.songLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="external-link"
                  >
                    Öppna låt i Spotify →
                  </a>
                )}

                <div class="guess-section">
                  <label for={`guess_${submission.id}`} class="guess-label">
                    Vem tror du valde låten?
                  </label>
                  <select
                    id={`guess_${submission.id}`}
                    name={`guess_${submission.id}`}
                    class="guess-select"
                    required
                  >
                    <option value="">-- Välj deltagare --</option>
                    {participants.map((participant) => (
                      <option
                        value={participant.id}
                        data-name={displayText(participant.name)}
                        selected={existingGuess === participant.id}
                      >
                        {displayText(participant.name)}
                      </option>
                    ))}
                  </select>
                </div>
              </div>
            );
          })
        }
      </div>

      <div class="form-actions">
        <output id="guess-progress" aria-live="polite"></output>
        <p id="unsaved-indicator" class="unsaved-indicator" hidden>
          ⚠️ Du har osparade ändringar
        </p>
        <button type="submit" class="btn-primary btn-large">
          Spara gissningar
        </button>
      </div>
    </form>
      )
    }

    {/* Admin controls */}
    {
      isAdmin && (
        <div class="admin-section">
          <h3>⚠️ Administratör</h3>
          <p class="warning-text">
            Varning: Återställning till öppet läge kommer att radera alla
            gissningar som har gjorts.
          </p>
          <form
            method="POST"
            onsubmit="return confirm('Är du säker? Detta kommer att radera alla gissningar och öppna quizet för nya låtinlämningar.');"
          >
            <input type="hidden" name="action" value="reset_to_open" />
            <button type="submit" class="btn-danger">
              Återställ till öppet läge och radera alla gissningar
            </button>
          </form>
        </div>
      )
    }
  </div>
</Layout>

<script>
  // Tracks the guesses currently selected in the form (not yet saved) so we
  // can warn the user when the same participant is picked more than once.
  const selects = Array.from(
    document.querySelectorAll<HTMLSelectElement>('.guess-select'),
  );

  const progress = document.getElementById('guess-progress');

  function updateSelectionCounts() {
    if (progress) progress.textContent = `${selects.filter(s => s.value).length} av ${selects.length} låtar valda`;
    const currentSelections = new Map<string, string>();
    for (const select of selects) {
      if (select.value) currentSelections.set(select.name, select.value);
    }

    const counts = new Map<string, number>();
    for (const guessedUserId of currentSelections.values()) {
      counts.set(guessedUserId, (counts.get(guessedUserId) ?? 0) + 1);
    }

    for (const select of selects) {
      for (const option of Array.from(select.options)) {
        if (!option.value) continue;
        const baseName = option.dataset.name ?? option.textContent ?? '';
        const count = counts.get(option.value) ?? 0;
        option.textContent = count > 0 ? `${baseName} (vald ${count} ${count === 1 ? 'gång' : 'gånger'})` : baseName;
      }
    }
  }

  for (const select of selects) {
    select.addEventListener('change', updateSelectionCounts);
  }

  updateSelectionCounts();

  // Warn the user when they have unsaved guess changes.
  const initialValues = new Map(selects.map((select) => [select.name, select.value]));
  const unsavedIndicator = document.getElementById('unsaved-indicator');
  const guessingForm = document.querySelector<HTMLFormElement>('.guessing-form');
  let hasUnsavedChanges = false;

  function updateUnsavedState() {
    hasUnsavedChanges = selects.some(
      (select) => select.value !== initialValues.get(select.name),
    );
    unsavedIndicator?.toggleAttribute('hidden', !hasUnsavedChanges);
  }

  for (const select of selects) {
    select.addEventListener('change', updateUnsavedState);
  }

  guessingForm?.addEventListener('submit', () => {
    hasUnsavedChanges = false;

    // Give immediate feedback while the page reloads with the save confirmation.
    const submitButton =
      guessingForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = 'Sparar...';
    }
  });

  window.addEventListener('beforeunload', (event) => {
    if (!hasUnsavedChanges) return;
    event.preventDefault();
    event.returnValue = '';
  });

  // Auto-dismiss the "saved" confirmation and drop ?saved=1 from the URL.
  const successMessage = document.getElementById('success-message');
  if (successMessage) {
    setTimeout(() => {
      successMessage.classList.add('fade-out');
      setTimeout(() => successMessage.remove(), 500);
    }, 3000);

    const url = new URL(window.location.href);
    url.searchParams.delete('saved');
    window.history.replaceState({}, '', url);
  }
</script>
