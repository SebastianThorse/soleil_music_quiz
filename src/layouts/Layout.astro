---
import Head from './Head.astro';
import Navbar from './Navbar.astro';
import '../styles/app.css';
interface Props { presentation?: boolean; }
const { presentation = false } = Astro.props;
---

<!doctype html>
<html lang="sv">
  <Head />
  <body>
    <a href="#main" class="skip-link">Hoppa till innehållet</a>
    {!presentation && <Navbar />}
    <main id="main" class:list={{ 'app-main': !presentation }}>
      <slot />
    </main>
  </body>
</html>
